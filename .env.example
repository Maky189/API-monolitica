# Copy this file to .env and fill in secure values before deploying

# JWT secret — use a long random string in production
# Example: openssl rand -hex 64
JWT_SECRET=change-me-in-production

# Token expiry in hours
JWT_EXPIRY_HOURS=24

# Internal service-to-service shared secret
# Example: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=internal-secret-change-me

# User passwords (replace in production with a real user DB)
ADMIN_PASSWORD=admin123
USER_PASSWORD=user123

# CORS allowed origins (comma-separated, or * for all)
ALLOWED_ORIGINS=*

# Payment timeout in seconds
PAYMENT_TIMEOUT_SECONDS=3
